{
  "name": "auto-read-pdf-pro",
  "version": "2.1.0",
  "description": "Auto Read PDF Pro - Modern Desktop Application for PDF Extraction and ePort Vessel/Container Tracking",
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": ".venv/bin/python -m backend.app.main",
    "dev": "cross-env NODE_ENV=development concurrently -k -n \"FRONTEND,BACKEND,ELECTRON\" -c \"blue,green,magenta\" \"cd frontend && npm run dev\" \".venv/bin/python -m backend.app.main\" \"wait-on http://localhost:5173 && wait-on http-get://127.0.0.1:8000/health && electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:py:mac": "cross-env PYINSTALLER_CONFIG_DIR=.pyinstaller_cache pyinstaller backend_app.spec --noconfirm --clean",
    "build:py:win": "pyinstaller backend_app.spec --noconfirm --clean",
    "build": "npm run build:frontend && electron-builder",
    "build:mac": "npm run build:frontend && npm run build:py:mac && electron-builder --mac",
    "build:win": "npm run build:frontend && npm run build:py:win && electron-builder --win",
    "test:py": "pytest tests/"
  },
  "keywords": [
    "electron",
    "react",
    "fastapi",
    "pdf-extractor",
    "eport-snp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.autoreadpdf.pro",
    "productName": "Auto Read PDF Pro",
    "publish": [
      {
        "provider": "github",
        "owner": "NguyenNgocBaoITITIU19084",
        "repo": "auto_read_pdf",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3"
    ],
    "extraResources": [
      {
        "from": "dist/backend_app",
        "to": "backend_dist",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.sqlite",
          "!**/*.sqlite3",
          "!**/__pycache__/**"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-Mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
